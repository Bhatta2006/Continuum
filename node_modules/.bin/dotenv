#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/Continuum/node_modules/.pnpm/dotenv@18.0.4/node_modules/dotenv/node_modules:/mnt/d/Continuum/node_modules/.pnpm/dotenv@18.0.4/node_modules:/mnt/d/Continuum/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/Continuum/node_modules/.pnpm/dotenv@18.0.4/node_modules/dotenv/node_modules:/mnt/d/Continuum/node_modules/.pnpm/dotenv@18.0.4/node_modules:/mnt/d/Continuum/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/dotenv@18.0.4/node_modules/dotenv/dist/index.cjs" "$@"
else
  exec node  "$basedir/../.pnpm/dotenv@18.0.4/node_modules/dotenv/dist/index.cjs" "$@"
fi
